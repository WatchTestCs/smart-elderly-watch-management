{
  "name": "suining-ui",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "test:api-drift": "node scripts/test-api-drift.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/check-typescript-scope.mjs && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "typecheck:stable": "node scripts/check-typescript-scope.mjs && vue-tsc --noEmit --stableTypeOrdering -p tsconfig.app.json && tsc --noEmit --stableTypeOrdering -p tsconfig.node.json && vue-tsc --noEmit --stableTypeOrdering -p tsconfig.test.json",
    "api:tools:ci": "npm ci --prefix tools/openapi --ignore-scripts --no-audit --no-fund",
    "check:vue36": "node scripts/check-vue36-readiness.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tauri-apps/api": "2.12.4",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.7",
    "leaflet": "1.9.4",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.4",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "@types/leaflet": "1.9.22"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
